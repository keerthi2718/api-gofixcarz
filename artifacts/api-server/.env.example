# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Garage Management API"
APP_VERSION="1.0.0"
ENVIRONMENT=development   # development | production
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
# Replit injects DATABASE_URL automatically.
# For local / Docker use, set it here:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/garage_db

# ─── Security ─────────────────────────────────────────────────────────────────
# Replit uses SESSION_SECRET for this. Generate a strong random string for local use:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-super-secret-key-change-in-production

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300   # 5 minutes
OTP_LENGTH=6

# ─── MSG91 SMS ────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_DLT_TE_ID=1307175464483723626
MSG91_SENDER=MYSKWT
MSG91_ROUTE=4
MSG91_COUNTRY=91

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:5173","http://localhost:5174","https://partner.gofixcarz.com"]

# ─── JWT ──────────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days
