modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd /home/runner/workspace/artifacts/api-server && uvicorn app.main:app --host 0.0.0.0 --port $PORT"]
build = ["sh", "-c", "cd /home/runner/workspace/artifacts/api-server && pip install -r requirements.txt -q 2>/dev/null || true"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql"]
